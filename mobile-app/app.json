{
  "expo": {
    "name": "SBK Global Auto Trading",
    "slug": "sbk-website",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F5F7",
    "primaryColor": "#D71920",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sbkautotrading.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Used for voice notes and calls in the website's live chat.",
        "NSCameraUsageDescription": "Used for video calls in the website's live chat.",
        "NSPhotoLibraryUsageDescription": "Used to pick a picture for your profile or to send in the live chat."
      }
    },
    "android": {
      "package": "com.sbkautotrading.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO",
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withLowMemoryBuild",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to pick a picture for your profile or to send in the live chat."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111216",
          "image": "./assets/site/logo.png",
          "imageWidth": 170
        }
      ]
    ]
  }
}
